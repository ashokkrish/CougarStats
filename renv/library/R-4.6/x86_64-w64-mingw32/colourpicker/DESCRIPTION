Package: colourpicker
Title: A Colour Picker Tool for Shiny and for Selecting Colours in
        Plots
Version: 1.3.0
Authors@R: c(
    person("Dean", "Attali", 
        email = "daattali@gmail.com",
        role = c("aut", "cre"),
        comment= c(ORCID="0000-0002-5645-3493")),
    person("David", "Griswold", email="novachild@gmail.com",
    role = "ctb")
